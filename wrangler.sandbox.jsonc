{
  // Isolated JBH checkout test Worker. NOT a production release configuration.
  // The same Beauty Co account ID is verified in test mode; the key mode remains test-only.
  "name": "jusspay-jbh-sandbox",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-05",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {"name":"BILLING","class_name":"BillingAccount"},
      {"name":"JBH_ORDERS","class_name":"JbhOrderBook"}
    ]
  },
  "migrations": [
    {"tag":"v1","new_sqlite_classes":["BillingAccount"]},
    {"tag":"v2","new_sqlite_classes":["JbhOrderBook"]}
  ],
  "previews": {
    "vars": {
      "STRIPE_LIVE": "false",
      "APPROVED_PLANS": "{}",
      "PAYMENTS_ENABLED": "false",
      "JBH_ORDERS_ENABLED": "false",
      "JBH_STRIPE_LIVE": "false",
      "JBH_TEST_ACCOUNT_ID": "acct_1TfbELRp7J40bCrl"
    },
    "durable_objects": {
      "bindings": [
        {"name":"BILLING","class_name":"BillingAccount"},
        {"name":"JBH_ORDERS","class_name":"JbhOrderBook"}
      ]
    }
  },
  "vars": {
    "STRIPE_LIVE": "false",
    "PAYMENTS_ENABLED": "false",
    "APPROVED_PLANS": "{}",
    "JBH_STRIPE_LIVE": "false",
    "JBH_ORDERS_ENABLED": "true",
    "JBH_STRIPE_API_VERSION": "2026-11-18.endive",
    "JBH_TEST_ACCOUNT_ID": "acct_1TfbELRp7J40bCrl"
  }
}
