{
  "name": "jusspay",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-05",
  "workers_dev": false,
  "preview_urls": false,
  "services": [
    { "binding": "AUTH", "service": "jusspay-auth" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "BILLING", "class_name": "BillingAccount" },
      { "name": "JBH_ORDERS", "class_name": "JbhOrderBook" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BillingAccount"] },
    { "tag": "v2", "new_sqlite_classes": ["JbhOrderBook"] }
  ],
  "vars": {
    "STRIPE_LIVE": "false",
    "APPROVED_PLANS": "{}",
    "JBH_ORDERS_ENABLED": "true",
    "JBH_STRIPE_LIVE": "true",
    "JBH_LIVE_CHARGES_APPROVED": "false",
    "JBH_STOREFRONT_ORIGIN": "https://jussbeautifulhair.com",
    "RELEASE_SHA": "f8872857fc6f020580d0a3b71b02a9b5d45c6ece"
  }
}
